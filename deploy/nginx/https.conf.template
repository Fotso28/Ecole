limit_req_zone $binary_remote_addr zone=ecole_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=ecole_auth:10m rate=10r/m;
limit_req_status 429;

# Paiements : demandes (POST) limitées par adresse et par session (jeton Bearer),
# confirmations des opérateurs limitées par adresse.
map $request_method $ecole_pay_ip {
  POST $binary_remote_addr;
  default "";
}
map $request_method:$http_authorization $ecole_pay_user {
  ~^POST:(?<bearer>.+)$ $bearer;
  default "";
}
limit_req_zone $ecole_pay_ip zone=ecole_pay_ip:10m rate=60r/m;
limit_req_zone $ecole_pay_user zone=ecole_pay_user:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=ecole_webhooks:10m rate=120r/m;

server {
  listen 80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};
  ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  include /etc/nginx/snippets/ecole-locations.conf;
}
