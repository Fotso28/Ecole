# Copier en .env sur le serveur et remplacer toutes les valeurs « changer ».
DOMAIN=ecole.example.cm
NGINX_MODE=http
API_IMAGE=ghcr.io/votre-organisation/ecole-api:latest
WEB_IMAGE=ghcr.io/votre-organisation/ecole-web:latest

POSTGRES_DB=ecole
POSTGRES_USER=ecole
POSTGRES_PASSWORD=changer-mot-de-passe-long
DATABASE_URL=postgresql://ecole:changer-mot-de-passe-long@postgres:5432/ecole
REDIS_URL=redis://redis:6379

# openssl rand -base64 48
JWT_SECRET=changer
OTP_SECRET=changer
# openssl rand -hex 32 (chiffrement des fiches santé et des secrets de double authentification)
DATA_ENCRYPTION_KEY=changer

WEB_ORIGIN=https://ecole.example.cm
PUBLIC_VERIFY_URL=https://ecole.example.cm/verifier

# Passerelle SMS (agrégateur local) : console | http
SMS_PROVIDER=http
SMS_HTTP_URL=https://passerelle-sms.example.cm/send
SMS_HTTP_TOKEN=changer
SMS_SENDER=ECOLE
# E-mail (annonces, messages, rappels) : console | smtp. Voir docs/exploitation.md.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.cm
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=changer
EMAIL_FROM=Ecole <no-reply@example.cm>

# Mobile Money : simulator | http (agrégateur) | operators (MTN MoMo et Orange Money en direct)
MOBILE_MONEY_PROVIDER=http
MOBILE_MONEY_HTTP_URL=https://agregateur.example.cm/v1
MOBILE_MONEY_HTTP_TOKEN=changer
MOBILE_MONEY_WEBHOOK_SECRET=changer
# Adresses IP autorisées pour les webhooks, séparées par des virgules (vide = pas de filtre)
MOBILE_MONEY_ALLOWED_IPS=

# Raccordement direct (MOBILE_MONEY_PROVIDER=operators) : voir docs/exploitation.md.
# MTN MoMo, API Collection. Bac à sable : https://sandbox.momodeveloper.mtn.com, environnement
# « sandbox », devise EUR. Production : URL remise par MTN, environnement « mtncameroon », XAF.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CURRENCY=XAF
MTN_MOMO_CALLBACK_URL=https://ecole.example.cm/api/webhooks/mtn-momo
# Orange Money Cameroun, paiement marchand. Pré-production : https://api-s1.orange.cm.
ORANGE_MONEY_BASE_URL=https://api-s1.orange.cm
ORANGE_MONEY_API_PATH=/omcoreapis/1.0.2
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_AUTH_TOKEN=
ORANGE_MONEY_CHANNEL_MSISDN=
ORANGE_MONEY_CHANNEL_PIN=
ORANGE_MONEY_CALLBACK_URL=https://ecole.example.cm/api/webhooks/orange-money
# Limites dédiées aux paiements : « requêtes/secondes », plusieurs fenêtres séparées par des virgules.
PAYMENT_RATE_PORTAL=5/600,20/86400
PAYMENT_RATE_CASHIER=30/60,600/3600
PAYMENT_RATE_CALLBACK=120/60
# Plafond journalier de SMS de connexion pour les demandes anonymes (toutes écoles confondues).
OTP_DAILY_SMS_BUDGET=2000
# Stockage des fichiers (pièces d'inscription, justificatifs, supports de cours) : local | s3
# En production, utiliser s3 : OVH Object Storage, ou MinIO (docker compose --profile minio up -d).
STORAGE_PROVIDER=s3
# MinIO du docker-compose (interne : les fichiers sont servis par l'API)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ecole
S3_ACCESS_KEY_ID=ecole
S3_SECRET_ACCESS_KEY=changer
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_DOWNLOADS=false
# OVH Object Storage (exemple) :
# S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# S3_REGION=gra
# S3_PRESIGNED_DOWNLOADS=true
FILE_MAX_BYTES=10485760
FILE_URL_TTL_SECONDS=300

# Journaux : JSON en production (LOG_FORMAT=text pour une lecture humaine), niveau log par défaut
LOG_LEVEL=log
# Collecte centralisée facultative (Loki + Vector + Grafana, environ 550 Mo de mémoire) :
# COMPOSE_FILE=docker-compose.yml:docker-compose.logs.yml
# GRAFANA_ADMIN_PASSWORD=changer
# LOG_RETENTION=336h

# Alertes à l'équipe technique (numéros et adresses séparés par des virgules)
ALERT_SMS_TO=+237690000000
ALERT_EMAIL_TO=technique@example.cm
ALERT_COOLDOWN_MINUTES=60
# Passerelle e-mail HTTP générique (EMAIL_PROVIDER=http) : POST JSON { to, from, subject, text }
# EMAIL_HTTP_URL=
# EMAIL_HTTP_TOKEN=
