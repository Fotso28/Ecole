// Schéma de données : chaque table métier porte un schoolId (multi-établissement).
// Montants en FCFA entiers, notes en centièmes de point (1342 = 13,42).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StaffRole {
  DIRECTOR
  CENSOR
  SUPERVISOR
  SECRETARY
  ACCOUNTANT
  TEACHER
  NURSE
}

enum TokenKind {
  STAFF
  PARENT
}

enum Gender {
  F
  M
}

enum EnrollmentStatus {
  ENROLLED
  REPEATING
  TRANSFERRED
  LEFT
}

enum GuardianRelationship {
  FATHER
  MOTHER
  TUTOR
  OTHER
}

enum SubjectGroup {
  LITERARY
  SCIENTIFIC
  OTHER
}

enum AcademicYearStatus {
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum JustificationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EvaluationType {
  QUIZ
  HOMEWORK
  EXAM
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum GradeStatus {
  SCORE
  ABSENT
  EXEMPT
}

enum ReportCardStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum CouncilDecisionType {
  HONOR_ROLL
  ENCOURAGEMENT
  WARNING
  BLAME
  NONE
}

/// Décision de fin d'année du conseil de classe (dernier trimestre).
enum YearEndDecisionType {
  PROMOTED
  PROMOTED_BY_COUNCIL
  REPEAT
  EXCLUDED_WORK
  EXCLUDED_CONDUCT
}

enum PaymentMethod {
  CASH
  BANK
  MTN_MOMO
  ORANGE_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum LedgerEntryType {
  CHARGE
  DISCOUNT
  PAYMENT
  REVERSAL
  ADJUSTMENT
}

enum CashSessionStatus {
  OPEN
  CLOSED
  APPROVED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum AnnouncementScope {
  SCHOOL
  CYCLE
  LEVEL
  CLASS
  STUDENTS
}

enum MessageAuthor {
  PARENT
  STAFF
}

enum EventCategory {
  PARENT_MEETING
  HOLIDAY
  CELEBRATION
  OUTING
  EXAM
  OTHER
}

enum EventScope {
  SCHOOL
  CYCLE
  LEVEL
  CLASS
}

enum DocumentStatus {
  RECEIVED
  MISSING
}

model School {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  city            String
  address         String?
  phone           String?
  matriculePrefix String
  settings        Json         @default("{}")
  modules         String[]     @default(["students", "attendance", "grades", "finance", "communication", "portal"])
  status          SchoolStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships Membership[]
  years       AcademicYear[]
  students    Student[]
}

model User {
  id                String     @id @default(cuid())
  email             String?    @unique
  phone             String?    @unique
  passwordHash      String?
  firstName         String
  lastName          String
  isPlatformAdmin   Boolean    @default(false)
  mfaSecret         String?
  mfaEnabled        Boolean    @default(false)
  /// Codes de double authentification erronés consécutifs ; verrouillage temporaire au-delà de 5.
  mfaFailedAttempts Int        @default(0)
  mfaLockedUntil    DateTime?
  /// Dernier pas TOTP accepté : un code ne sert qu'une fois.
  mfaLastStep       Int?
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  guardians     Guardian[]
}

model Membership {
  id             String      @id @default(cuid())
  userId         String
  schoolId       String
  roles          StaffRole[]
  maxWeeklyHours Int?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  kind       TokenKind
  schoolId   String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  /// Demande faite depuis un appareil de confiance (déjà connecté avec ce numéro) : quota séparé.
  trusted    Boolean   @default(false)
  /// SMS réellement envoyé (numéro connu d'une école) : base du plafond de coût.
  sent       Boolean   @default(false)

  @@index([phone, createdAt])
  @@index([sent, createdAt])
}

/// Code de connexion parent erroné : plafond d'essais par numéro, séparé pour les appareils de confiance.
model OtpFailure {
  id        String   @id @default(cuid())
  phone     String
  trusted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model AcademicYear {
  id        String             @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(OPEN)
  createdAt DateTime           @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms   Term[]
  classes Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  order          Int
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sequences    Sequence[]

  @@unique([academicYearId, order])
  @@index([schoolId])
}

model Sequence {
  id       String @id @default(cuid())
  schoolId String
  termId   String
  name     String
  order    Int

  term        Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@unique([termId, order])
  @@index([schoolId])
}

model Cycle {
  id       String @id @default(cuid())
  schoolId String
  name     String
  order    Int

  levels Level[]

  @@unique([schoolId, name])
}

model Level {
  id       String @id @default(cuid())
  schoolId String
  cycleId  String
  name     String
  order    Int

  cycle   Cycle   @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  classes Class[]

  @@unique([schoolId, name])
}

model Class {
  id             String  @id @default(cuid())
  schoolId       String
  academicYearId String
  levelId        String
  name           String
  capacity       Int?
  mainTeacherId  String?

  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  level        Level          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  subjects     ClassSubject[]
  enrollments  Enrollment[]

  @@unique([academicYearId, name])
  @@index([schoolId])
}

model Subject {
  id       String       @id @default(cuid())
  schoolId String
  name     String
  code     String
  group    SubjectGroup

  classSubjects ClassSubject[]

  @@unique([schoolId, code])
}

model ClassSubject {
  id          String  @id @default(cuid())
  schoolId    String
  classId     String
  subjectId   String
  coefficient Int
  teacherId   String?
  weeklyHours Int?

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  evaluations Evaluation[]

  @@unique([classId, subjectId])
  @@index([schoolId, teacherId])
}

model Student {
  id               String    @id @default(cuid())
  schoolId         String
  matricule        String
  firstName        String
  lastName         String
  gender           Gender
  birthDate        DateTime  @db.Date
  birthPlace       String?
  nationality      String    @default("Camerounaise")
  photoConsent     Boolean   @default(false)
  /// Date et auteur du dernier changement du consentement à la photo (loi sur les données personnelles).
  photoConsentAt   DateTime?
  photoConsentById String?
  /// Photo d'identité, chiffrée ; déposée seulement avec le consentement, retirée avec lui.
  photoFileId      String?
  previousSchool   String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  guardians   StudentGuardian[]
  enrollments Enrollment[]
  documents   StudentDocument[]
  health      HealthRecord?
  photoFile   StoredFile?       @relation("StudentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)

  @@unique([schoolId, matricule])
  @@index([schoolId, lastName])
  @@index([schoolId, lastName, firstName])
}

model Guardian {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  firstName String
  lastName  String
  phone     String
  email     String?
  createdAt DateTime @default(now())

  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@unique([schoolId, phone])
  @@index([phone])
}

model StudentGuardian {
  id                 String               @id @default(cuid())
  schoolId           String
  studentId          String
  guardianId         String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  canPickUp          Boolean              @default(true)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([schoolId])
}

model Enrollment {
  id                   String           @id @default(cuid())
  schoolId             String
  studentId            String
  classId              String
  academicYearId       String
  status               EnrollmentStatus @default(ENROLLED)
  previousEnrollmentId String?
  createdAt            DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([schoolId, classId])
  @@index([schoolId, academicYearId, status])
}

model StudentDocument {
  id        String         @id @default(cuid())
  schoolId  String
  studentId String
  type      String
  status    DocumentStatus @default(MISSING)
  fileKey   String?
  /// Fichier déposé (le statut reste réglable à la main, avec ou sans fichier).
  fileId    String?
  createdAt DateTime       @default(now())

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  file    StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([studentId, type])
}

model HealthRecord {
  id               String   @id @default(cuid())
  schoolId         String
  studentId        String   @unique
  /// Contenu chiffré (AES-256-GCM) : allergies, traitements, contacts médicaux.
  encryptedPayload String
  updatedAt        DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model AttendanceSession {
  id             String   @id @default(cuid())
  schoolId       String
  classId        String
  classSubjectId String?
  date           DateTime @db.Date
  startTime      String
  endTime        String
  takenById      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  records AttendanceRecord[]

  @@unique([classId, date, startTime])
  @@index([schoolId, date])
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  schoolId        String
  sessionId       String
  studentId       String
  status          AttendanceStatus
  justificationId String?
  notifiedAt      DateTime?

  session       AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  justification Justification?    @relation(fields: [justificationId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId])
}

model Justification {
  id            String              @id @default(cuid())
  schoolId      String
  studentId     String
  submittedById String
  reason        String
  status        JustificationStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  /// Pièce jointe (certificat médical, convocation…), déposée par le parent ou l'école.
  fileId        String?

  records AttendanceRecord[]
  file    StoredFile?        @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
}

model Incident {
  id           String       @id @default(cuid())
  schoolId     String
  studentId    String
  date         DateTime     @db.Date
  description  String
  sanction     String?
  reportedById String
  createdAt    DateTime     @default(now())
  type         IncidentType @default(OTHER)
  sanctionType SanctionType @default(NONE)

  @@index([schoolId, studentId])
  @@index([schoolId, date])
}

model Evaluation {
  id             String           @id @default(cuid())
  schoolId       String
  classSubjectId String
  sequenceId     String
  name           String
  type           EvaluationType
  weight         Int
  maxScore       Int              @default(20)
  date           DateTime?        @db.Date
  status         EvaluationStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime         @default(now())

  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  sequence     Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  grades       Grade[]

  @@index([schoolId, classSubjectId, sequenceId])
}

model Grade {
  id           String      @id @default(cuid())
  schoolId     String
  evaluationId String
  studentId    String
  status       GradeStatus
  valueCenti   Int?
  updatedById  String
  updatedAt    DateTime    @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, studentId])
  @@index([schoolId, studentId])
}

model ReportCard {
  id                  String           @id @default(cuid())
  schoolId            String
  studentId           String
  classId             String
  termId              String
  version             Int
  status              ReportCardStatus @default(DRAFT)
  /// Instantané figé du bulletin : matières, moyennes, rangs, assiduité, décision.
  data                Json
  generalAverageCenti Int?
  rank                Int?
  rankTied            Boolean          @default(false)
  classSize           Int
  verificationCode    String           @unique
  publishedAt         DateTime?
  publishedById       String?
  createdAt           DateTime         @default(now())
  /// Bulletin de fin d'année : moyenne générale et rang annuels.
  annualAverageCenti  Int?
  annualRank          Int?

  @@unique([studentId, termId, version])
  @@index([schoolId, classId, termId])
}

model CouncilDecision {
  id              String               @id @default(cuid())
  schoolId        String
  studentId       String
  termId          String
  decision        CouncilDecisionType
  comment         String?
  decidedById     String
  createdAt       DateTime             @default(now())
  /// Décision de fin d'année, saisie au dernier trimestre seulement.
  yearEndDecision YearEndDecisionType?

  @@unique([studentId, termId])
}

model FeeItem {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  amount         Int
  dueDate        DateTime @db.Date
  levelId        String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([schoolId, academicYearId])
}

model Invoice {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  createdAt      DateTime @default(now())

  lines InvoiceLine[]

  @@unique([studentId, academicYearId])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  schoolId       String
  invoiceId      String
  feeItemId      String?
  label          String
  amount         Int
  discount       Int      @default(0)
  discountReason String?
  dueDate        DateTime @db.Date
  order          Int      @default(0)

  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([schoolId, dueDate])
}

model Payment {
  id                String        @id @default(cuid())
  schoolId          String
  studentId         String
  amount            Int
  method            PaymentMethod
  status            PaymentStatus
  idempotencyKey    String
  operatorReference String?
  payerPhone        String?
  bankName          String?
  bankReference     String?
  cashSessionId     String?
  receivedById      String?
  initiatedByUserId String?
  /// Échéances choisies au moment de la demande (imputées en priorité à la confirmation).
  requestedLineIds  String[]      @default([])
  failureReason     String?
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?
  reversedAt        DateTime?
  reversalReason    String?
  reversedById      String?

  allocations PaymentAllocation[]
  receipt     Receipt?

  @@unique([schoolId, idempotencyKey])
  @@unique([method, operatorReference])
  @@index([schoolId, studentId])
  @@index([status, createdAt])
  @@index([schoolId, createdAt])
}

model PaymentAllocation {
  id            String @id @default(cuid())
  schoolId      String
  paymentId     String
  invoiceLineId String
  amount        Int

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)

  @@index([schoolId, invoiceLineId])
}

model Receipt {
  id               String   @id @default(cuid())
  schoolId         String
  paymentId        String   @unique
  number           String
  verificationCode String   @unique
  issuedAt         DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([schoolId, number])
}

/// Écritures comptables en ajout seul : un déclencheur interdit UPDATE et DELETE.
model LedgerEntry {
  id            String          @id @default(cuid())
  schoolId      String
  studentId     String
  type          LedgerEntryType
  /// Montant signé : positif = dette de la famille, négatif = paiement ou remise.
  amount        Int
  invoiceLineId String?
  paymentId     String?
  description   String
  createdById   String?
  createdAt     DateTime        @default(now())

  @@index([schoolId, studentId])
}

model CashSession {
  id             String            @id @default(cuid())
  schoolId       String
  openedById     String
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  closedById     String?
  expectedAmount Int?
  countedAmount  Int?
  note           String?
  status         CashSessionStatus @default(OPEN)
  approvedById   String?
  approvedAt     DateTime?

  @@index([schoolId, status])
}

model Reminder {
  id            String              @id @default(cuid())
  schoolId      String
  studentId     String
  invoiceLineId String
  scheduledFor  DateTime            @db.Date
  channel       NotificationChannel @default(SMS)
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  @@unique([invoiceLineId, scheduledFor])
  @@index([schoolId])
}

model NotificationOutbox {
  id          String              @id @default(cuid())
  schoolId    String?
  channel     NotificationChannel
  recipient   String
  template    String
  body        String
  payload     Json                @default("{}")
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  availableAt DateTime            @default(now())
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([status, availableAt])
}

model Announcement {
  id          String            @id @default(cuid())
  schoolId    String
  title       String
  body        String
  scope       AnnouncementScope
  targetId    String?
  /// Portée STUDENTS : élèves dont les parents sont destinataires.
  studentIds  String[]          @default([])
  authorId    String
  publishedAt DateTime          @default(now())

  @@index([schoolId, publishedAt])
}

/// Fil de discussion entre un parent et un membre du personnel, au sujet d'un élève.
model MessageThread {
  id               String    @id @default(cuid())
  schoolId         String
  studentId        String
  guardianId       String
  staffUserId      String
  createdById      String
  createdAt        DateTime  @default(now())
  lastMessageAt    DateTime  @default(now())
  parentLastReadAt DateTime?
  staffLastReadAt  DateTime?

  messages Message[]

  @@unique([studentId, guardianId, staffUserId])
  @@index([schoolId, staffUserId, lastMessageAt])
  @@index([schoolId, guardianId])
}

model Message {
  id           String        @id @default(cuid())
  schoolId     String
  threadId     String
  authorKind   MessageAuthor
  authorUserId String
  body         String
  createdAt    DateTime      @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([schoolId])
}

/// Événement du calendrier (réunion de parents, congé, fête, sortie…), dates incluses.
model SchoolEvent {
  id             String        @id @default(cuid())
  schoolId       String
  title          String
  description    String?
  category       EventCategory
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  startTime      String?
  endTime        String?
  location       String?
  scope          EventScope
  targetId       String?
  remindBySms    Boolean       @default(false)
  reminderSentAt DateTime?
  authorId       String
  createdAt      DateTime      @default(now())

  @@index([schoolId, startDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
}

model Counter {
  schoolId String
  key      String
  value    Int

  @@id([schoolId, key])
}

model Room {
  id       String @id @default(cuid())
  schoolId String
  name     String
  capacity Int?

  @@unique([schoolId, name])
}

model TimetableEntry {
  id             String  @id @default(cuid())
  schoolId       String
  academicYearId String
  classId        String
  classSubjectId String
  teacherId      String?
  roomId         String?
  dayOfWeek      Int
  startTime      String
  endTime        String

  @@index([schoolId, academicYearId])
}

enum SubscriptionPricing {
  PER_STUDENT
  PER_MODULE
}

enum SubscriptionInvoiceStatus {
  ISSUED
  CANCELLED
}

/// Offre d'abonnement de la plateforme (catalogue commun, montants annuels en FCFA).
model SubscriptionPlan {
  id              String              @id @default(cuid())
  name            String              @unique
  pricing         SubscriptionPricing
  /// Prix par élève inscrit et par an (offre PER_STUDENT).
  pricePerStudent Int                 @default(0)
  /// Prix annuel par module activé, par exemple { "grades": 150000 } (offre PER_MODULE).
  modulePrices    Json                @default("{}")
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())

  subscriptions SchoolSubscription[]
}

/// Offre retenue par un établissement.
model SchoolSubscription {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  planId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
}

/// Facture d'abonnement, calculée sur des chiffres agrégés (effectif, modules) et figée à l'émission.
model SubscriptionInvoice {
  id           String                    @id @default(cuid())
  schoolId     String
  number       String                    @unique
  /// Année scolaire facturée, par exemple « 2026-2027 ».
  period       String
  planName     String
  pricing      SubscriptionPricing
  studentCount Int
  modules      String[]
  /// Détail : [{ label, quantity, unitPrice, amount }].
  lines        Json
  amount       Int
  dueDate      DateTime                  @db.Date
  status       SubscriptionInvoiceStatus @default(ISSUED)
  issuedById   String?
  issuedAt     DateTime                  @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  payments  SubscriptionPayment[]
  reminders SubscriptionReminder[]

  @@index([schoolId, issuedAt])
}

/// Règlement d'une facture d'abonnement, en ajout seul : une correction est une écriture négative.
model SubscriptionPayment {
  id           String   @id @default(cuid())
  schoolId     String
  invoiceId    String
  /// Montant signé : négatif pour une écriture de correction.
  amount       Int
  method       String
  reference    String?
  paidOn       DateTime @db.Date
  note         String?
  correctsId   String?  @unique
  recordedById String?
  createdAt    DateTime @default(now())

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([schoolId, invoiceId])
}

/// Relance d'une facture d'abonnement impayée.
model SubscriptionReminder {
  id        String   @id @default(cuid())
  schoolId  String
  invoiceId String
  sentById  String?
  recipient String?
  createdAt DateTime @default(now())

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([schoolId, invoiceId])
}

enum IncidentType {
  INDISCIPLINE
  INSOLENCE
  VIOLENCE
  FRAUD
  DAMAGE
  TRUANCY
  DRESS_CODE
  OTHER
}

enum SanctionType {
  NONE
  WARNING
  DETENTION
  BLAME
  TEMPORARY_EXCLUSION
  DISCIPLINARY_COUNCIL
  PERMANENT_EXCLUSION
  OTHER
}

enum AdminDocumentType {
  SCHOOL_CERTIFICATE
  ENROLLMENT_ATTESTATION
  STUDENT_CARD
}

enum AdminDocumentStatus {
  ISSUED
  CANCELLED
}

/// Modèle de document administratif propre à chaque école : en-tête, signataire, mentions.
model DocumentTemplate {
  id             String            @id @default(cuid())
  schoolId       String
  type           AdminDocumentType
  title          String?
  headerLines    String[]          @default([])
  signatoryName  String?
  signatoryTitle String?
  mentions       String?
  updatedById    String?
  updatedAt      DateTime          @updatedAt

  @@unique([schoolId, type])
}

/// Registre des documents délivrés : numéro séquentiel par école, type et année ; jamais supprimé.
model AdminDocument {
  id               String              @id @default(cuid())
  schoolId         String
  type             AdminDocumentType
  number           String
  sequence         Int
  academicYearId   String
  studentId        String
  /// Instantané figé au moment de la délivrance : élève, classe, modèle, établissement.
  data             Json
  verificationCode String              @unique
  status           AdminDocumentStatus @default(ISSUED)
  duplicateOfId    String?
  /// Emplacement de la photo (carte d'élève), renseigné quand le stockage de fichiers sera disponible.
  photoKey         String?
  issuedById       String
  issuedAt         DateTime            @default(now())
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?

  @@unique([schoolId, number])
  @@unique([schoolId, type, academicYearId, sequence])
  @@index([schoolId, issuedAt])
  @@index([schoolId, studentId])
}

enum FileCategory {
  STUDENT_DOCUMENT
  STUDENT_PHOTO
  JUSTIFICATION
  COURSE_MATERIAL
}

/// Fichier stocké (disque local ou stockage compatible S3). Jamais supprimé physiquement par
/// l'application : la suppression est logique (`deletedAt`).
model StoredFile {
  id           String       @id @default(cuid())
  schoolId     String
  category     FileCategory
  /// Clé dans le stockage, générée par l'API (aucune partie fournie par l'utilisateur).
  storageKey   String       @unique
  originalName String
  /// Type vérifié sur le contenu réel du fichier.
  mimeType     String
  size         Int
  sha256       String
  /// Contenu chiffré au repos (AES-256-GCM) : pièces d'identité et justificatifs.
  encrypted    Boolean      @default(false)
  uploadedById String?
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?
  deletedById  String?

  studentDocuments StudentDocument[]
  justifications   Justification[]
  courseMaterials  CourseMaterial[]
  studentPhotos    Student[]         @relation("StudentPhoto")

  @@index([schoolId, category])
}

/// Cahier de texte : une séance (classe, matière, date), son contenu et le travail à faire.
model LessonLog {
  id              String    @id @default(cuid())
  schoolId        String
  classId         String
  classSubjectId  String
  date            DateTime  @db.Date
  startTime       String?
  content         String
  homework        String?
  homeworkDueDate DateTime? @db.Date
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  materials CourseMaterial[]

  @@index([schoolId, classId, date])
  @@index([schoolId, classId, homeworkDueDate])
  @@index([classSubjectId, date])
}

/// Support de cours rattaché à une classe et une matière, éventuellement à une séance.
model CourseMaterial {
  id             String    @id @default(cuid())
  schoolId       String
  classId        String
  classSubjectId String
  lessonLogId    String?
  title          String
  fileId         String
  uploadedById   String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  lessonLog LessonLog? @relation(fields: [lessonLogId], references: [id], onDelete: SetNull)
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([schoolId, classId])
  @@index([classSubjectId])
}
